local function BypassAdonis()
    if not _G.AdonisBypass then return end
    local RS = game:GetService("ReplicatedStorage")
    local detected = false
    local counter = 0
    for _, obj in pairs(game:GetDescendants()) do
        counter = counter + 1
        if counter % 50 == 0 then task.wait() end
        if obj.Name == "Adonis" or obj.Name == "AntiCheat" then detected = true; break end
    end
    if not detected then
        for _, n in pairs({"Adonis_Remote","Adonis_AntiCheat","Adonis_Check","Adonis_Validate","Adonis_Log","Adonis_Event"}) do
            if RS:FindFirstChild(n) then detected = true; break end
        end
    end
    if not detected then return end
    print("[UniversalPro] Adonis detected, applying bypass...")
    local mt = getrawmetatable(game)
    local oldNC = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" or method == "InvokeServer" then
            local sn = tostring(self):lower()
            if sn:find("adonis") or sn:find("anticheat") then return nil end
        end
        return oldNC(self, ...)
    end)
    setreadonly(mt, true)
    task.spawn(function()
        while task.wait(5) do
            pcall(function()
                if getgenv and getgenv().Adonis then getgenv().Adonis.Detected = false end
            end)
        end
    end)
    print("[UniversalPro] Adonis bypass applied.")
end
