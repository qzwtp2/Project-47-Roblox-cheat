local function IsPlayer(character)
    if not character or not character:IsA("Model") then return false end
    if character == LocalPlayer.Character then return true end
    return Players:GetPlayerFromCharacter(character) ~= nil
end

-- Cached NPC check — heavy string work only runs once per model lifetime
local function IsNPC(character)
    if NPC_Identity_Cache[character] ~= nil then
        return NPC_Identity_Cache[character]
    end

    if not character or not character:IsA("Model") then
        NPC_Identity_Cache[character] = false; return false
    end
    if IsPlayer(character) then
        NPC_Identity_Cache[character] = false; return false
    end

    local hum  = character:FindFirstChildOfClass("Humanoid")
    local head = character:FindFirstChild("Head")
    local hrp  = character:FindFirstChild("HumanoidRootPart")
    if not hum or not head or not hrp then
        NPC_Identity_Cache[character] = false; return false
    end

    if _G.AggressiveNPCDetection then
        NPC_Identity_Cache[character] = true; return true
    end

    local charName = character.Name:lower()
    for _, tag in pairs(NPCTags) do
        if charName:find(tag, 1, true) then
            NPC_Identity_Cache[character] = true; return true
        end
    end

    for _, fn in pairs(NPCFolderNames) do
        local f = workspace:FindFirstChild(fn)
        if f and character:IsDescendantOf(f) then
            NPC_Identity_Cache[character] = true; return true
        end
    end

    for _, ind in pairs({"NPC","IsNPC","IsEnemy","Hostile","Enemy","IsBot"}) do
        local v = character:FindFirstChild(ind)
        if v then
            if v:IsA("BoolValue") and v.Value then NPC_Identity_Cache[character]=true; return true end
            if v:IsA("StringValue") then
                local vl = v.Value:lower()
                if vl=="enemy" or vl=="hostile" or vl=="npc" or vl=="bot" then
                    NPC_Identity_Cache[character]=true; return true
                end
            end
        end
    end

    for _, tag in pairs(CollectionService:GetTags(character)) do
        local tl = tag:lower()
        for _, nt in pairs(NPCTags) do if tl:find(nt,1,true) then NPC_Identity_Cache[character]=true; return true end end
    end

    -- default: if it has humanoid+head+hrp and isn't a player, treat as NPC
    NPC_Identity_Cache[character] = true
    return true
end

local function IsDead(character)
    if not character then return true end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not hum then return true end
    if hum.Health <= 0 then return true end
    if hum:GetState() == Enum.HumanoidStateType.Dead then return true end
    local ko = character:FindFirstChild("K.O") or character:FindFirstChild("KO")
    if ko and (ko:IsA("BoolValue") or ko:IsA("IntValue")) and (ko.Value==true or ko.Value>0) then return true end
    return false
end

-- Cached friend check — no repeated API calls for same userId
local function IsFriend(player)
    if not player then return false end
    local uid = player.UserId
    if Friend_Cache[uid] ~= nil then return Friend_Cache[uid] end
    local ok, res = pcall(function() return LocalPlayer:IsFriendsWith(uid) end)
    Friend_Cache[uid] = ok and res or false
    return Friend_Cache[uid]
end

local function IsEnemyPlayer(player)
    if not _G.TeamCheck then return true end
    if _G.FriendCheck and IsFriend(player) then return false end
    if not player or not LocalPlayer.Team or not player.Team then return true end
    return LocalPlayer.Team ~= player.Team
end

local function IsEnemyNPC(npcModel)
    if not _G.TeamCheckForNPCs then return true end
    local tv = npcModel:FindFirstChild("Team")
    if tv and tv:IsA("StringValue") then
        local lt = LocalPlayer.Team and LocalPlayer.Team.Name or ""
        if tv.Value ~= lt then return true end
    end
    local ie = npcModel:FindFirstChild("IsEnemy")
    if ie and ie:IsA("BoolValue") and ie.Value then return true end
    return true
end

local function GetTargetPart(character)
    if _G.AimPart == "Head" then return character:FindFirstChild("Head")
    elseif _G.AimPart == "Torso" then
        return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
    elseif _G.AimPart == "Random" then
        local opts = {character:FindFirstChild("Head"),character:FindFirstChild("UpperTorso"),character:FindFirstChild("HumanoidRootPart")}
        for _,p in pairs(opts) do if p then return p end end
    elseif _G.AimPart == "Both" then
        local head  = character:FindFirstChild("Head")
        local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
        if head and torso then return tick()%1>0.5 and head or torso end
        return head or torso
    end
    return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
end

