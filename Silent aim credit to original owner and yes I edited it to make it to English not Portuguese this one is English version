local function wvp(pos)
    local v, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(v.X,v.Y), on, v.Z
end

local ESP_TICK     = 0
local ESP_INTERVAL = 1/12  -- 12fps cap for ESP

local function updateESP()
    if not ESP_Config.Enabled then
        for _,p in pairs(ESP_Objects) do setVis(p,false) end
        return
    end
    local camPos = Camera.CFrame.Position
    for model, parts in pairs(ESP_Objects) do
        local hum  = model:FindFirstChildOfClass("Humanoid")
        local root = model:FindFirstChild("HumanoidRootPart")
        if not hum or not root then setVis(parts,false); continue end
        if ESP_Config.DeadCheck and IsDead(model) then setVis(parts,false); continue end
        local isp = (getPlayerESP(model) ~= nil)
        if isp and not ESP_Config.ShowPlayers then setVis(parts,false); continue end
        if not isp and not ESP_Config.ShowNPCs then setVis(parts,false); continue end
        local dist = (root.Position-camPos).Magnitude
        if dist > ESP_Config.MaxDistance then setVis(parts,false); continue end
        if ESP_Config.TeamCheck and isAlly(model) then setVis(parts,false); continue end
        local rv, onScreen, depth = wvp(root.Position)
        if not onScreen or depth<=0 then setVis(parts,false); continue end

        local color = ESP_Config.EnemyColor
        if isAlly(model) then color=ESP_Config.AllyColor
        elseif ESP_Config.UseTeamColor then local tc=getTeamColor(model); if tc then color=tc end end

        local size = getCachedSize(model)

        if ESP_Config.ShowBox then
            local tv,_ = wvp(root.Position+Vector3.new(0,size.Y/2,0))
            local bv,_ = wvp(root.Position-Vector3.new(0,size.Y/2,0))
            local h=math.abs(tv.Y-bv.Y); local w=h/2
            parts.Box.Size=Vector2.new(w,h); parts.Box.Position=Vector2.new(rv.X-w/2,tv.Y)
            parts.Box.Color=color; parts.Box.Visible=true
        else parts.Box.Visible=false end

        if ESP_Config.ShowLine then
            parts.Line.From=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
            parts.Line.To=rv; parts.Line.Color=ESP_Config.LineColor; parts.Line.Visible=true
        else parts.Line.Visible=false end

        if ESP_Config.ShowStick then
            local hp = model:FindFirstChild("Head") or root
            local hv,hon = wvp(hp.Position); local fv,fon = wvp(root.Position-Vector3.new(0,size.Y/2,0))
            if hon and fon then parts.Stick.From=hv; parts.Stick.To=fv; parts.Stick.Color=ESP_Config.StickColor; parts.Stick.Visible=true
            else parts.Stick.Visible=false end
        else parts.Stick.Visible=false end

        if ESP_Config.ShowName then
            parts.NameText.Position=rv-Vector2.new(0,30); parts.NameText.Size=ESP_Config.NameTextSize
            parts.NameText.Color=color; parts.NameText.Text=model.Name; parts.NameText.Visible=true
        else parts.NameText.Visible=false end

        if ESP_Config.ShowDistance then
            parts.DistanceText.Position=rv-Vector2.new(0,15); parts.DistanceText.Size=ESP_Config.DistanceTextSize
            parts.DistanceText.Color=Color3.fromRGB(255,255,255); parts.DistanceText.Text=string.format("[%.0f m]",dist)
            parts.DistanceText.Visible=true
        else parts.DistanceText.Visible=false end

        if ESP_Config.ShowHPBar then
            local pct=math.clamp(hum.Health/hum.MaxHealth,0,1)
            local bw=ESP_Config.HPBarWidth; local bh=ESP_Config.HPBarHeight
            local bx=rv.X-bw/2; local by=rv.Y+25
            parts.HPBarBack.Size=Vector2.new(bw,bh); parts.HPBarBack.Position=Vector2.new(bx,by); parts.HPBarBack.Visible=true
            parts.HPBar.Size=Vector2.new(bw*pct,bh); parts.HPBar.Position=Vector2.new(bx,by)
            parts.HPBar.Color=Color3.fromRGB(255*(1-pct),255*pct,0); parts.HPBar.Visible=true
            parts.HPText.Position=Vector2.new(rv.X,by+bh+8)
            parts.HPText.Text=string.format("%.0f/%.0f",hum.Health,hum.MaxHealth); parts.HPText.Visible=true
        else parts.HPBarBack.Visible=false; parts.HPBar.Visible=false; parts.HPText.Visible=false end

        if ESP_Config.ShowEquippedItem then
            local item=getEquippedTool(model)
            if item then parts.ItemText.Position=rv-Vector2.new(0,45); parts.ItemText.Color=Color3.fromRGB(120,255,120); parts.ItemText.Text="["..item.."]"; parts.ItemText.Visible=true
            else parts.ItemText.Visible=false end
        else parts.ItemText.Visible=false end
    end
end

-- Non-blocking scan: players first, then workspace in async task
local function scanWorkspace()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hum=plr.Character:FindFirstChildOfClass("Humanoid")
            local root=plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and root then createESP(plr.Character) end
        end
    end
    task.spawn(function()
        local counter = 0
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") then
                local hum=obj:FindFirstChildOfClass("Humanoid")
                local root=obj:FindFirstChild("HumanoidRootPart")
                if hum and root then
                    if not getPlayerESP(obj) then createESP(obj) end
                end
                counter=counter+1
                if counter%20==0 then task.wait() end
            end
        end
    end)
end

