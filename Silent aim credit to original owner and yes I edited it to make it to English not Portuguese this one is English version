local function getCachedSize(model)
    local now = tick()
    if not Size_Cache_Age[model] or (now - Size_Cache_Age[model]) > SIZE_TTL then
        local ok, sz = pcall(function() return model:GetExtentsSize() end)
        Size_Cache[model]     = ok and sz or Vector3.new(4,6,4)
        Size_Cache_Age[model] = now
    end
    return Size_Cache[model]
end

