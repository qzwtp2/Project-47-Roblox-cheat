local function CreateHighlight(target)
    if not target or not target:IsA("Model") then return nil end
    if TargetHighlight then TargetHighlight:Destroy(); TargetHighlight=nil end
    if HighlightConnection then HighlightConnection:Disconnect(); HighlightConnection=nil end
    local h = Instance.new("Highlight")
    h.Name="SilentAimHighlight"; h.Adornee=target
    h.FillColor=Color3.fromRGB(255,50,50); h.FillTransparency=0.7
    h.OutlineColor=Color3.fromRGB(255,255,255); h.OutlineTransparency=0
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent=game:GetService("CoreGui")
    HighlightConnection = target.Destroying:Connect(function()
        if h then h:Destroy(); TargetHighlight=nil end
    end)
    return h
end

local function UpdateHighlight()
    if not _G.HighlightTarget then
        if TargetHighlight then TargetHighlight:Destroy(); TargetHighlight=nil end
        if HighlightConnection then HighlightConnection:Disconnect(); HighlightConnection=nil end
        return
    end
    if CurrentTarget then
        if not TargetHighlight or TargetHighlight.Adornee ~= CurrentTarget then
            TargetHighlight = CreateHighlight(CurrentTarget)
        end
        if TargetHighlight then
            local isp = false
            for _,d in pairs(PlayerCache) do if d.Model==CurrentTarget then isp=true; break end end
            TargetHighlight.FillColor = isp and _G.HighlightPlayerColor or _G.HighlightNPCColor
            TargetHighlight.FillTransparency = 0.7
        end
    else
        if TargetHighlight then TargetHighlight:Destroy(); TargetHighlight=nil end
        if HighlightConnection then HighlightConnection:Disconnect(); HighlightConnection=nil end
    end
end

--// ==================================================
--// 9. CACHE UPDATE
--// ==================================================
local function UpdateCaches()
    local now = tick()
    if now - LastCacheUpdate < CacheUpdateInterval then return end
    LastCacheUpdate = now
    local tempNPC = {}; local tempPlayer = {}; local counter = 0
    local function tryAdd(model)
        counter = counter + 1
        if counter % 5 == 0 then task.wait() end
        if not model or not model:IsA("Model") or model == LocalPlayer.Character then return end
        local hrp = model:FindFirstChild("HumanoidRootPart")
        local hum = model:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        if _G.DeadCheck and IsDead(model) then return end
        if IsPlayer(model) then
            tempPlayer[model] = {Model=model, HRP=hrp, Humanoid=hum, Player=Players:GetPlayerFromCharacter(model), IsNPC=false}
        elseif IsNPC(model) then
            tempNPC[model] = {Model=model, HRP=hrp, Humanoid=hum, IsNPC=true}
        end
    end
    for _, child in pairs(workspace:GetChildren()) do tryAdd(child) end
    for _, fn in pairs(NPCFolderNames) do
        local folder = workspace:FindFirstChild(fn)
        if folder then for _, child in pairs(folder:GetDescendants()) do if child:IsA("Model") then tryAdd(child) end end end
    end
    if _G.AggressiveNPCDetection then
        for _, d in pairs(workspace:GetDescendants()) do
            if d:IsA("Model") and not tempNPC[d] and not tempPlayer[d] then tryAdd(d) end
        end
    end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local hrp  = char:FindFirstChild("HumanoidRootPart")
            local hum  = char:FindFirstChildOfClass("Humanoid")
            if hrp and hum and not (_G.DeadCheck and IsDead(char)) then
                tempPlayer[char] = {Model=char, HRP=hrp, Humanoid=hum, Player=plr, IsNPC=false}
            end
        end
    end
    NPCCache = tempNPC; PlayerCache = tempPlayer
end

--// ==================================================
--// 10. SILENT AIM TARGETING
--// ==================================================
local function ValidateCurrentTarget()
    if not CurrentTarget or not TargetPart then return false end
    local hum = CurrentTarget:FindFirstChildOfClass("Humanoid")
    local hrp = CurrentTarget:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end
    if _G.DeadCheck and IsDead(CurrentTarget) then return false end
    if _G.EnableDistanceLimit and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        if (TargetPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude > _G.MaxAimDistance then return false end
    end
    local sc = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local sp, onScreen = Camera:WorldToViewportPoint(TargetPart.Position)
    if not onScreen then return false end
    if (Vector2.new(sp.X,sp.Y)-sc).Magnitude > _G.FOV then return false end
    if _G.VisibleCheck then
        AimRayParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
        local dir = TargetPart.Position - Camera.CFrame.Position
        local ray = workspace:Raycast(Camera.CFrame.Position, dir, AimRayParams)
        if ray and not ray.Instance:IsDescendantOf(CurrentTarget) then return false end
    end
    return true
end

local function ShouldHit()
    if _G.HitChance >= 100 then return true end
    if _G.HitChance <= 0   then return false end
    return math.random(1,100) <= _G.HitChance
end

local function GetTarget()
    if not LocalPlayer.Character then TargetInRange=false; TargetPart=nil; return nil end
    UpdateCaches()
    if _G.StickyAim and CurrentTarget then
        if ValidateCurrentTarget() then TargetInRange=true; return CurrentTarget
        else CurrentTarget=nil; TargetPart=nil end
    end
    local bestScore = math.huge
    local closestPart, closestTgt = nil, nil
    local sc = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local localRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    TargetInRange=false; TargetPart=nil
    if not localRoot then return nil end
    local function ProcessTarget(data, isPlayer)
        local hrp = data.HRP; local hum = data.Humanoid
        if not hrp or not hum then return end
        if _G.DeadCheck and IsDead(data.Model) then return end
        if isPlayer then if not IsEnemyPlayer(data.Player) then return end
        else if not IsEnemyNPC(data.Model) then return end end
        if _G.EnableDistanceLimit then
            if (hrp.Position-localRoot.Position).Magnitude > _G.MaxAimDistance then return end
        end
        local tp = GetTargetPart(data.Model) or hrp
        local tPos = tp.Position
        if hrp.Velocity.Magnitude > 1 and _G.Prediction > 0 then tPos = tPos + hrp.Velocity*_G.Prediction end
        local sp, onScreen = Camera:WorldToViewportPoint(tPos)
        if not onScreen then return end
        local d2d = (Vector2.new(sp.X,sp.Y)-sc).Magnitude
        if d2d > _G.FOV then return end
        TargetInRange = true
        local visible = true
        if _G.VisibleCheck then
            AimRayParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
            local dir = tPos - Camera.CFrame.Position
            local ray = workspace:Raycast(Camera.CFrame.Position, dir, AimRayParams)
            if ray and not ray.Instance:IsDescendantOf(data.Model) then visible=false end
        end
        if visible or not _G.VisibleCheck then
            local score = _G.TargetPriority=="Crosshair" and d2d
                       or _G.TargetPriority=="Distance"  and (tPos-localRoot.Position).Magnitude
                       or _G.TargetPriority=="LowestHP"  and hum.Health
                       or d2d
            if score < bestScore then bestScore=score; closestPart=tp; closestTgt=data.Model end
        end
    end
    if _G.TargetMode=="NPCs" or _G.TargetMode=="Both" then for _,d in pairs(NPCCache) do ProcessTarget(d,false) end end
    if _G.TargetMode=="Players" or _G.TargetMode=="Both" then for _,d in pairs(PlayerCache) do ProcessTarget(d,true) end end
    TargetPart = closestPart
    return closestTgt
end

local function CalculateHitChanceDisplay()
    if not CurrentTarget or not TargetPart then return 0 end
    local base = _G.HitChance; local df, ff = 1.0, 1.0
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local d = (TargetPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
        df = d<50 and 1.1 or d>200 and 0.8 or 1.0
    end
    ff = _G.FOV<100 and 1.15 or _G.FOV>250 and 0.9 or 1.0
    return math.floor(math.clamp(base*df*ff+math.random(-5,5),1,100))
end

local function UpdateTargetInfo()
    if not _G.ShowTarget or not _G.SilentAim then TargetInfo.Visible=false; TargetInfo.Text=""; return end
    if CurrentTarget and TargetPart then
        local sp, onScreen = Camera:WorldToViewportPoint(TargetPart.Position)
        if onScreen then
            TargetInfo.Visible=true; TargetInfo.Position=Vector2.new(sp.X, sp.Y+20)
            local lines = {}
            if _G.ShowTargetName then
                local name, ttype = CurrentTarget.Name, "NPC"
                for _,d in pairs(PlayerCache) do if d.Model==CurrentTarget then ttype="Player"; name=d.Player.Name; break end end
                table.insert(lines, _G.ShowTargetType and string.format("[%s] %s",ttype,name) or name)
            end
            if _G.ShowTargetHP then
                local h = CurrentTarget:FindFirstChildOfClass("Humanoid")
                if h then table.insert(lines, string.format("HP: %.0f/%.0f",h.Health,h.MaxHealth)) end
            end
            if _G.ShowTargetDistance and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                table.insert(lines, string.format("Dist: %.1f",(TargetPart.Position-LocalPlayer.Character.HumanoidRootPart.Position).Magnitude))
            end
            if _G.ShowHitChance then table.insert(lines, string.format("Chance: %d%%",CalculateHitChanceDisplay())) end
            TargetInfo.Text = #lines>0 and table.concat(lines,"\n") or "Target locked"
        else TargetInfo.Visible=false; TargetInfo.Text="" end
    else TargetInfo.Visible=false; TargetInfo.Text="" end
end

