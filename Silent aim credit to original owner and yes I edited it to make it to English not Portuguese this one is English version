local function applyBulletTP(origin, tp)
    if not _G.BulletTP or not tp then return origin end
    return (tp.CFrame*CFrame.new(0,0,1)).p
end

if not oldNamecall then
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        if not _G.SilentAim or not TargetPart or not CurrentTarget then return oldNamecall(self,...) end
        local method = getnamecallmethod(); local args={...}
        if (method=="FireServer" or method=="InvokeServer") and typeof(self)=="Instance" then
            local sn=self.Name:lower()
            if sn:find("fire") or sn:find("hit") or sn:find("attack") or sn:find("damage") then
                if not ShouldHit() then return oldNamecall(self,...) end
                local newArgs={}; local modified=false
                for i,arg in pairs(args) do
                    if typeof(arg)=="Vector3" then newArgs[i]=_G.BulletTP and applyBulletTP(arg,TargetPart) or TargetPart.Position; modified=true
                    elseif typeof(arg)=="CFrame" then local o=_G.BulletTP and applyBulletTP(arg.Position,TargetPart) or TargetPart.Position; newArgs[i]=CFrame.new(o); modified=true
                    elseif typeof(arg)=="Ray" then local o=_G.BulletTP and applyBulletTP(arg.Origin,TargetPart) or arg.Origin; newArgs[i]=Ray.new(o,(TargetPart.Position-o).Unit*1000); modified=true
                    else newArgs[i]=arg end
                end
                if modified then return oldNamecall(self,unpack(newArgs)) end
            end
        end
        if method=="Raycast" and self==workspace then
            local origin=args[1]
            if origin and TargetPart then
                if not ShouldHit() then return oldNamecall(self,...) end
                local o=_G.BulletTP and applyBulletTP(origin,TargetPart) or origin
                return oldNamecall(self,o,(TargetPart.Position-o).Unit*args[2].Magnitude,args[3],args[4])
            end
        end
        return oldNamecall(self,...)
    end)
end

if not oldIndex then
    oldIndex = hookmetamethod(game, "__index", function(self, key)
        if self==Mouse and _G.SilentAim and TargetPart then
            local kl=key:lower()
            if kl=="hit" then
                if not ShouldHit() then return oldIndex(self,key) end
                return CFrame.new(_G.BulletTP and applyBulletTP(self.Origin,TargetPart) or TargetPart.Position)
            elseif kl=="target" then return TargetPart end
        end
        return oldIndex(self,key)
    end)
end

