local function SA_UpdateHighlight()
	if not _G.HighlightTarget then
		if SA_TargetHighlight then SA_TargetHighlight:Destroy(); SA_TargetHighlight=nil end
		if SA_HLConn then SA_HLConn:Disconnect(); SA_HLConn=nil end; return
	end
	if SA_CurrentTarget then
		if not SA_TargetHighlight or SA_TargetHighlight.Adornee~=SA_CurrentTarget then
			SA_TargetHighlight=SA_CreateHighlight(SA_CurrentTarget)
		end
		if SA_TargetHighlight then
			local isp=false
			for _,d in pairs(SA_PlayerCache) do if d.Model==SA_CurrentTarget then isp=true; break end end
			SA_TargetHighlight.FillColor=isp and _G.HighlightPlayerColor or _G.HighlightNPCColor
			SA_TargetHighlight.FillTransparency=0.7
		end
	else
		if SA_TargetHighlight then SA_TargetHighlight:Destroy(); SA_TargetHighlight=nil end
		if SA_HLConn then SA_HLConn:Disconnect(); SA_HLConn=nil end
	end
end

local function SA_UpdateCaches()
	local now=tick()
	if now-SA_LastCacheUpdate<SA_CacheInterval then return end
	SA_LastCacheUpdate=now
	local tempNPC={}; local tempPlayer={}; local counter=0
	local function tryAdd(model)
		counter=counter+1
		if counter%5==0 then task.wait() end
		if not model or not model:IsA("Model") or model==lp.Character then return end
		local hrp=model:FindFirstChild("HumanoidRootPart")
		local hum=model:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum then return end
		if _G.DeadCheck and SA_IsDead(model) then return end
		if SA_IsPlayer(model) then
			tempPlayer[model]={Model=model,HRP=hrp,Humanoid=hum,Player=Players:GetPlayerFromCharacter(model),IsNPC=false}
		elseif SA_IsNPC(model) then
			tempNPC[model]={Model=model,HRP=hrp,Humanoid=hum,IsNPC=true}
		end
	end
	for _,child in pairs(workspace:GetChildren()) do tryAdd(child) end
	for _,fn in pairs(SA_NPCFolders) do
		local folder=workspace:FindFirstChild(fn)
		if folder then for _,child in pairs(folder:GetDescendants()) do if child:IsA("Model") then tryAdd(child) end end end
	end
	if _G.AggressiveNPCDetection then
		for _,d in pairs(workspace:GetDescendants()) do
			if d:IsA("Model") and not tempNPC[d] and not tempPlayer[d] then tryAdd(d) end
		end
	end
	for _,plr in pairs(Players:GetPlayers()) do
		if plr~=lp and plr.Character then
			local char=plr.Character
			local hrp=char:FindFirstChild("HumanoidRootPart")
			local hum=char:FindFirstChildOfClass("Humanoid")
			if hrp and hum and not (_G.DeadCheck and SA_IsDead(char)) then
				tempPlayer[char]={Model=char,HRP=hrp,Humanoid=hum,Player=plr,IsNPC=false}
			end
		end
	end
	SA_NPCCache=tempNPC; SA_PlayerCache=tempPlayer
end

local function SA_ValidateCurrentTarget()
	if not SA_CurrentTarget or not SA_TargetPart then return false end
	local hum=SA_CurrentTarget:FindFirstChildOfClass("Humanoid")
	local hrp=SA_CurrentTarget:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return false end
	if _G.DeadCheck and SA_IsDead(SA_CurrentTarget) then return false end
	if _G.EnableDistanceLimit and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
		if (SA_TargetPart.Position-lp.Character.HumanoidRootPart.Position).Magnitude>_G.MaxAimDistance then return false end
	end
	local sc=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
	local sp,onScreen=Camera:WorldToViewportPoint(SA_TargetPart.Position)
	if not onScreen then return false end
	if (Vector2.new(sp.X,sp.Y)-sc).Magnitude>_G.FOV then return false end
	if _G.VisibleCheck then
		AimRayParams.FilterDescendantsInstances={lp.Character,Camera}
		local dir=SA_TargetPart.Position-Camera.CFrame.Position
		local ray=workspace:Raycast(Camera.CFrame.Position,dir,AimRayParams)
		if ray and not ray.Instance:IsDescendantOf(SA_CurrentTarget) then return false end
	end
	return true
end

local function SA_ShouldHit()
	if _G.HitChance>=100 then return true end
	if _G.HitChance<=0 then return false end
	return math.random(1,100)<=_G.HitChance
end

local function SA_GetTarget()
	if not lp.Character then SA_TargetInRange=false; SA_TargetPart=nil; return nil end
	SA_UpdateCaches()
	if _G.StickyAim and SA_CurrentTarget then
		if SA_ValidateCurrentTarget() then SA_TargetInRange=true; return SA_CurrentTarget
		else SA_CurrentTarget=nil; SA_TargetPart=nil end
	end
	local bestScore=math.huge; local closestPart,closestTgt=nil,nil
	local sc=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
	local localRoot=lp.Character:FindFirstChild("HumanoidRootPart")
	SA_TargetInRange=false; SA_TargetPart=nil
	if not localRoot then return nil end
	local function ProcessTarget(data,isPlayer)
		local hrp=data.HRP; local hum=data.Humanoid
		if not hrp or not hum then return end
		if _G.DeadCheck and SA_IsDead(data.Model) then return end
		if isPlayer then if not SA_IsEnemyPlayer(data.Player) then return end
		else if not SA_IsEnemyNPC(data.Model) then return end end
		if _G.EnableDistanceLimit then
			if (hrp.Position-localRoot.Position).Magnitude>_G.MaxAimDistance then return end
		end
		local tp=SA_GetTargetPart(data.Model) or hrp
		local tPos=tp.Position
		if hrp.Velocity.Magnitude>1 and _G.Prediction>0 then tPos=tPos+hrp.Velocity*_G.Prediction end
		local sp,onScreen=Camera:WorldToViewportPoint(tPos)
		if not onScreen then return end
		local d2d=(Vector2.new(sp.X,sp.Y)-sc).Magnitude
		if d2d>_G.FOV then return end
		SA_TargetInRange=true
		local visible=true
		if _G.VisibleCheck then
			AimRayParams.FilterDescendantsInstances={lp.Character,Camera}
			local dir=tPos-Camera.CFrame.Position
			local ray=workspace:Raycast(Camera.CFrame.Position,dir,AimRayParams)
			if ray and not ray.Instance:IsDescendantOf(data.Model) then visible=false end
		end
		if visible or not _G.VisibleCheck then
			local score=_G.TargetPriority=="Crosshair" and d2d
				or _G.TargetPriority=="Distance" and (tPos-localRoot.Position).Magnitude
				or _G.TargetPriority=="LowestHP" and hum.Health
				or d2d
			if score<bestScore then bestScore=score; closestPart=tp; closestTgt=data.Model end
		end
	end
	if _G.TargetMode=="NPCs" or _G.TargetMode=="Both" then for _,d in pairs(SA_NPCCache) do ProcessTarget(d,false) end end
	if _G.TargetMode=="Players" or _G.TargetMode=="Both" then for _,d in pairs(SA_PlayerCache) do ProcessTarget(d,true) end end
	SA_TargetPart=closestPart; return closestTgt
end

local function SA_CalcHitChanceDisplay()
	if not SA_CurrentTarget or not SA_TargetPart then return 0 end
	local base=_G.HitChance; local df,ff=1.0,1.0
	if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
		local d=(SA_TargetPart.Position-lp.Character.HumanoidRootPart.Position).Magnitude
		df=d<50 and 1.1 or d>200 and 0.8 or 1.0
	end
	ff=_G.FOV<100 and 1.15 or _G.FOV>250 and 0.9 or 1.0
	return math.floor(math.clamp(base*df*ff+math.random(-5,5),1,100))
end

