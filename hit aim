	-- ==============================
	RunService.Heartbeat:Connect(function()
		if tick()-lastUpdate<rngInterval then return end
		rngInterval=0.28+math.random()*0.04; lastUpdate=tick()
		if NPC_HITBOX_ON then
			for char in pairs(KnownNPCs) do
				if char and char.Parent then applyHitbox(char,false,useHead,useBody,headSize,bodySize,transparency,NPC_MELEE_ON,NPC_THREAT_COLOR,false)
				else KnownNPCs[char]=nil end
			end
		end
		if PLAYER_HITBOX_ON then
			for plr in pairs(KnownPlayers) do
				if plr and plr.Character then
					local skip=false
					if TEAM_CHECK and lp.Team and plr.Team and lp.Team==plr.Team then skip=true end
					if FRIEND_CHECK and isFriend(plr) then skip=true end
					if not skip then applyHitbox(plr.Character,true,pUseHead,pUseBody,pHeadSize,pBodySize,pTrans,PLAYER_MELEE_ON,PLAYER_THREAT_COLOR,PLAYER_HEALTH_COLOR) end
				end
			end
		end
		if ESP_ON then for char in pairs(KnownNPCs) do if char and char.Parent then applyESP(char) else KnownNPCs[char]=nil end end end
		if PLAYER_ESP_ON then for plr in pairs(KnownPlayers) do applyPESP(plr) end end
		if H_HEARTBEAT then
			local _,nd=getNearestEnemy(); local spd=math.clamp(1+(1-nd/maxDistance)*3,1,4)
			hbSnd.PlaybackSpeed=spd; if not hbSnd.IsPlaying then hbSnd:Play() end
		elseif hbSnd.IsPlaying then hbSnd:Stop() end
		if H_FLOAT_NUMS then
			for char in pairs(KnownNPCs) do updFloatNum(char) end
			for plr in pairs(KnownPlayers) do if plr.Character then updFloatNum(plr.Character) end end
		end
		if H_SOUL_LEECH then
			for char in pairs(KnownNPCs) do updSoulLeech(char) end
			for plr in pairs(KnownPlayers) do if plr.Character then updSoulLeech(plr.Character) end end
		end
		if H_WATCHER then local nearest=getNearestEnemy(); if nearest then updWatcher(nearest) end end
		if H_GHOST_MODE then
			for char in pairs(KnownNPCs) do updGhostMode(char) end
			for plr in pairs(KnownPlayers) do if plr.Character then updGhostMode(plr.Character) end end
		end
		if H_CORRUPTION then
			for char in pairs(KnownNPCs) do if getDist(char)<=maxDistance then updCorruption(char) end end
			for plr in pairs(KnownPlayers) do if plr.Character and getDist(plr.Character)<=maxDistance then updCorruption(plr.Character) end end
		end
		if H_SHADOW_CLONE then
			for char in pairs(KnownNPCs) do updShadowClone(char) end
			for plr in pairs(KnownPlayers) do if plr.Character then updShadowClone(plr.Character) end end
		end
		if H_BLOOD_TRAIL then
			for char in pairs(KnownNPCs) do spawnBloodTrail(char) end
			for plr in pairs(KnownPlayers) do if plr.Character then spawnBloodTrail(plr.Character) end end
		end
		if H_THE_MARK then local nearest=getNearestEnemy(); if nearest then applyMark(nearest) end end
		if H_VOID_CAGE then local nearest=getNearestEnemy(); if nearest then doVoidCage(nearest) end end
		if H_PHANTOM_STEP then
			for char in pairs(KnownNPCs) do spawnPhantom(char) end
			for plr in pairs(KnownPlayers) do if plr.Character then spawnPhantom(plr.Character) end end
		end
		if H_FOG then updFog() end
		if H_RED_RAIN then spawnRedRain() end
		if H_GROUND_CRACK then
			for char in pairs(KnownNPCs) do updGroundCrack(char) end
			for plr in pairs(KnownPlayers) do if plr.Character then updGroundCrack(plr.Character) end end
		end
		if H_FLICKER then updFlicker() elseif flickerTime>0 then flickerTime=0; stopFlicker() end
	end)

