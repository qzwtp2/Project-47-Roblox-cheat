local function SA_UpdateTargetInfo()
	if not SA_TargetInfo then return end
	if not _G.ShowTarget or not _G.SilentAim then SA_TargetInfo.Visible=false; SA_TargetInfo.Text=""; return end
	if SA_CurrentTarget and SA_TargetPart then
		local sp,onScreen=Camera:WorldToViewportPoint(SA_TargetPart.Position)
		if onScreen then
			SA_TargetInfo.Visible=true; SA_TargetInfo.Position=Vector2.new(sp.X,sp.Y+20)
			local lines={}
			if _G.ShowTargetName then
				local name,ttype=SA_CurrentTarget.Name,"NPC"
				for _,d in pairs(SA_PlayerCache) do if d.Model==SA_CurrentTarget then ttype="Player"; name=d.Player.Name; break end end
				table.insert(lines,_G.ShowTargetType and string.format("[%s] %s",ttype,name) or name)
			end
			if _G.ShowTargetHP then
				local h=SA_CurrentTarget:FindFirstChildOfClass("Humanoid")
				if h then table.insert(lines,string.format("HP: %.0f/%.0f",h.Health,h.MaxHealth)) end
			end
			if _G.ShowTargetDistance and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
				table.insert(lines,string.format("Dist: %.1f",(SA_TargetPart.Position-lp.Character.HumanoidRootPart.Position).Magnitude))
			end
			if _G.ShowHitChance then table.insert(lines,string.format("Chance: %d%%",SA_CalcHitChanceDisplay())) end
			SA_TargetInfo.Text=#lines>0 and table.concat(lines,"\n") or "Target locked"
		else SA_TargetInfo.Visible=false; SA_TargetInfo.Text="" end
	else SA_TargetInfo.Visible=false; SA_TargetInfo.Text="" end
end

-- SA Hooks
local function SA_ApplyBulletTP(origin,tp)
	if not _G.BulletTP or not tp then return origin end
	return (tp.CFrame*CFrame.new(0,0,1)).p
end

local function SA_ApplyHooks()
	if not SA_oldNamecall then
		SA_oldNamecall=hookmetamethod(game,"__namecall",function(self,...)
			if not _G.SilentAim or not SA_TargetPart or not SA_CurrentTarget then return SA_oldNamecall(self,...) end
			local method=getnamecallmethod(); local args={...}
			if (method=="FireServer" or method=="InvokeServer") and typeof(self)=="Instance" then
				local sn=self.Name:lower()
				if sn:find("fire") or sn:find("hit") or sn:find("attack") or sn:find("damage") then
					if not SA_ShouldHit() then return SA_oldNamecall(self,...) end
					local newArgs={}; local modified=false
					for i,arg in pairs(args) do
						if typeof(arg)=="Vector3" then newArgs[i]=_G.BulletTP and SA_ApplyBulletTP(arg,SA_TargetPart) or SA_TargetPart.Position; modified=true
						elseif typeof(arg)=="CFrame" then local o=_G.BulletTP and SA_ApplyBulletTP(arg.Position,SA_TargetPart) or SA_TargetPart.Position; newArgs[i]=CFrame.new(o); modified=true
						elseif typeof(arg)=="Ray" then local o=_G.BulletTP and SA_ApplyBulletTP(arg.Origin,SA_TargetPart) or arg.Origin; newArgs[i]=Ray.new(o,(SA_TargetPart.Position-o).Unit*1000); modified=true
						else newArgs[i]=arg end
					end
					if modified then return SA_oldNamecall(self,unpack(newArgs)) end
				end
			end
			if method=="Raycast" and self==workspace then
				local origin=args[1]
				if origin and SA_TargetPart then
					if not SA_ShouldHit() then return SA_oldNamecall(self,...) end
					local o=_G.BulletTP and SA_ApplyBulletTP(origin,SA_TargetPart) or origin
					return SA_oldNamecall(self,o,(SA_TargetPart.Position-o).Unit*args[2].Magnitude,args[3],args[4])
				end
			end
			return SA_oldNamecall(self,...)
		end)
	end
	if not SA_oldIndex then
		SA_oldIndex=hookmetamethod(game,"__index",function(self,key)
			if self==Mouse and _G.SilentAim and SA_TargetPart then
				local kl=key:lower()
				if kl=="hit" then
					if not SA_ShouldHit() then return SA_oldIndex(self,key) end
					return CFrame.new(_G.BulletTP and SA_ApplyBulletTP(self.Origin,SA_TargetPart) or SA_TargetPart.Position)
				elseif kl=="target" then return SA_TargetPart end
			end
			return SA_oldIndex(self,key)
		end)
	end
end

