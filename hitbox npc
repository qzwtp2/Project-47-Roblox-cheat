	local function savePart(part)
		if part and not partData[part] then
			partData[part] = {
				size = part.Size,
				transparency = part.Transparency,
				material = part.Material,
				color = part.Color,
				canCollide = part.CanCollide,
				massless = part.Massless
			}
		end
	end

	local function restorePart(part)
		local d = partData[part]
		if not d then return end
		part.Size = d.size
		part.Transparency = d.transparency
		part.Material = d.material
		part.Color = d.color
		part.CanCollide = d.canCollide
		part.Massless = d.massless
	end

	local function isNPC(model)
		if not model or not model:IsA("Model") then return false end
		local hum = model:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return false end
		return Players:GetPlayerFromCharacter(model) == nil
	end

	local function applyHitbox(npc)
		local head = npc:FindFirstChild("Head")
		local hrp = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso") or npc:FindFirstChild("UpperTorso")

		if useHead and head and head:IsA("BasePart") then
			savePart(head)
			head.Size = Vector3.new(headSize, headSize, headSize)
			head.Transparency = hitboxTrans
			head.Material = Enum.Material.Neon
			head.Color = Color3.fromRGB(255, 40, 40)
			head.CanCollide = false
			head.Massless = true
		end

		if useBody and hrp and hrp:IsA("BasePart") then
			savePart(hrp)
			hrp.Size = Vector3.new(bodySize, bodySize, bodySize)
			hrp.Transparency = hitboxTrans
			hrp.Material = Enum.Material.Neon
			hrp.Color = Color3.fromRGB(255, 40, 40)
			hrp.CanCollide = false
		end
	end

	local function resetHitbox(npc)
		local head = npc:FindFirstChild("Head")
		local hrp = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso") or npc:FindFirstChild("UpperTorso")
		if head then restorePart(head) end
		if hrp then restorePart(hrp) end
	end

	local function applyESP(npc)
		local h = npc:FindFirstChild("NPCHighlight")
		if not h then
			h = Instance.new("Highlight")
			h.Name = "NPCHighlight"
			h.Adornee = npc
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.OutlineColor = Color3.fromRGB(255, 255, 255)
			h.Parent = npc
		end
		h.FillColor = currentColor
		h.FillTransparency = fillTrans
		h.Enabled = true
	end

	local function removeESP(npc)
		local h = npc:FindFirstChild("NPCHighlight")
		if h then h:Destroy() end
	end

	local function shouldAffect(npc)
		local name = npc.Name
		if NameEnabled[name] == nil then NameEnabled[name] = true end
		return NameEnabled[name] == true
	end

	local function applyToAll()
		for npc in pairs(NPCCache) do
			if npc and npc.Parent then
				if shouldAffect(npc) then
					if HITBOX_ON then applyHitbox(npc) else resetHitbox(npc) end
					if ESP_ON then applyESP(npc) else removeESP(npc) end
				else
					resetHitbox(npc)
					removeESP(npc)
				end
			else
				NPCCache[npc] = nil
			end
		end
	end

	local function addToCache(model)
		if isNPC(model) and not NPCCache[model] then
			NPCCache[model] = true
			if NameEnabled[model.Name] == nil then NameEnabled[model.Name] = true end
			if shouldAffect(model) then
				if HITBOX_ON then applyHitbox(model) end
				if ESP_ON then applyESP(model) end
			end
		end
	end

	task.spawn(function()
		for _, item in pairs(Workspace:GetDescendants()) do
			if item:IsA("Humanoid") then addToCache(item.Parent) end
		end
	end)

	Workspace.DescendantAdded:Connect(function(obj)
		if obj:IsA("Humanoid") then
			task.defer(function() addToCache(obj.Parent) end)
		end
	end)

	local function refreshNPCList()
		for _, child in pairs(scroll:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
		local uniqueNames = {}
		for npc in pairs(NPCCache) do
			if npc and npc.Parent then uniqueNames[npc.Name] = true end
		end
		local y = 0
		for name in pairs(uniqueNames) do
			local enabled = NameEnabled[name]
			if enabled == nil then enabled = true end
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, 0, 0, 32)
			btn.BackgroundColor3 = enabled and Color3.fromRGB(0, 110, 50) or Color3.fromRGB(50, 50, 55)
			btn.Text = (enabled and "[ON]  " or "[OFF] ") .. name
			btn.Font = Enum.Font.Gotham
			btn.TextSize = 13
			btn.TextColor3 = Color3.new(1,1,1)
			btn.BorderSizePixel = 0
			btn.Parent = scroll
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
			btn.MouseButton1Click:Connect(function()
				NameEnabled[name] = not NameEnabled[name]
				local now = NameEnabled[name]
				btn.BackgroundColor3 = now and Color3.fromRGB(0, 110, 50) or Color3.fromRGB(50, 50, 55)
				btn.Text = (now and "[ON]  " or "[OFF] ") .. name
				applyToAll()
			end)
			y = y + 38
		end
		scroll.CanvasSize = UDim2.new(0, 0, 0, y + 10)
	end

