-- Core
local function isNPC(model)
	if not model or not model:IsA("Model") then return false end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	return Players:GetPlayerFromCharacter(model) == nil
end

local function applyHitbox(npc)
	local head = npc:FindFirstChild("Head")
	local torso = npc:FindFirstChild("Torso") or npc:FindFirstChild("UpperTorso")
	if head and head:IsA("BasePart") then
		head.Size = Vector3.new(1,1,1)
		head.Material = Enum.Material.Plastic
		head.Transparency = 0
	end
	if torso and torso:IsA("BasePart") then
		torso.Size = Vector3.new(1,1,1)
		torso.Material = Enum.Material.Plastic
		torso.Transparency = 0
	end
	local p = npc:FindFirstChild(partName)
	if p and p:IsA("BasePart") then
		p.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
		p.Material = Enum.Material.ForceField
		p.Transparency = 0.45
		p.Color = Color3.fromRGB(255, 40, 40)
		p.CanCollide = false
	end
end

local function resetHitbox(npc)
	local head = npc:FindFirstChild("Head")
	local torso = npc:FindFirstChild("Torso") or npc:FindFirstChild("UpperTorso")
	if head and head:IsA("BasePart") then
		head.Size = Vector3.new(1,1,1)
		head.Material = Enum.Material.Plastic
		head.Transparency = 0
	end
	if torso and torso:IsA("BasePart") then
		torso.Size = Vector3.new(1,1,1)
		torso.Material = Enum.Material.Plastic
		torso.Transparency = 0
	end
end

local function applyESP(npc)
	local h = npc:FindFirstChild("NPCHighlight")
	if not h then
		h = Instance.new("Highlight")
		h.Name = "NPCHighlight"
		h.Adornee = npc
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.OutlineColor = Color3.fromRGB(255, 255, 255)
		h.Parent = npc
	end
	h.FillColor = currentColor
	h.FillTransparency = fillTrans
	h.Enabled = true
end

local function removeESP(npc)
	local h = npc:FindFirstChild("NPCHighlight")
	if h then h:Destroy() end
end

local function shouldAffect(npc)
	return EnabledNPCs[npc] == true
end

local function applyToAll()
	for npc in pairs(NPCCache) do
		if npc and npc.Parent then
			if shouldAffect(npc) then
				if HITBOX_ON then applyHitbox(npc) else resetHitbox(npc) end
				if ESP_ON then applyESP(npc) else removeESP(npc) end
			else
				resetHitbox(npc)
				removeESP(npc)
			end
		else
			NPCCache[npc] = nil
			EnabledNPCs[npc] = nil
		end
	end
end

local function addToCache(model)
	if isNPC(model) and not NPCCache[model] then
		NPCCache[model] = true
		EnabledNPCs[model] = true
		if shouldAffect(model) then
			if HITBOX_ON then applyHitbox(model) end
			if ESP_ON then applyESP(model) end
		end
	end
end

task.spawn(function()
	for _, item in pairs(Workspace:GetDescendants()) do
		if item:IsA("Humanoid") then
			addToCache(item.Parent)
		end
	end
end)

Workspace.DescendantAdded:Connect(function(obj)
	if obj:IsA("Humanoid") then
		task.defer(function()
			addToCache(obj.Parent)
		end)
	end
end)

local function refreshNPCList()
	for _, child in pairs(scroll:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local y = 0
	for npc in pairs(NPCCache) do
		if npc and npc.Parent then
			local name = npc.Name
			local enabled = EnabledNPCs[npc] == true

			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, 0, 0, 32)
			btn.BackgroundColor3 = enabled and Color3.fromRGB(0, 110, 50) or Color3.fromRGB(50, 50, 55)
			btn.Text = (enabled and "[ON]  " or "[OFF] ") .. name
			btn.Font = Enum.Font.Gotham
			btn.TextSize = 13
			btn.TextColor3 = Color3.new(1,1,1)
			btn.BorderSizePixel = 0
			btn.Parent = scroll
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

			btn.MouseButton1Click:Connect(function()
				EnabledNPCs[npc] = not EnabledNPCs[npc]
				local now = EnabledNPCs[npc]
				btn.BackgroundColor3 = now and Color3.fromRGB(0, 110, 50) or Color3.fromRGB(50, 50, 55)
				btn.Text = (now and "[ON]  " or "[OFF] ") .. name
				applyToAll()
			end)
			y = y + 38
		end
	end
	scroll.CanvasSize = UDim2.new(0, 0, 0, y + 10)
end

