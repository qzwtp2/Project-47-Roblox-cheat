	-- ========== CORE ==========
	local function isNPC(model)
		if not model or not model:IsA("Model") then return false end
		if Blacklist[model.Name] then return false end
		local hum = model:FindFirstChildOfClass("Humanoid")
		if not hum then return false end
		return Players:GetPlayerFromCharacter(model) == nil
	end

	local function getDistance(char)
		local myRoot = lp.Character and (lp.Character:FindFirstChild("HumanoidRootPart") or lp.Character:FindFirstChild("Torso"))
		local otherRoot = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
		if myRoot and otherRoot then
			return (myRoot.Position - otherRoot.Position).Magnitude
		end
		return 9999
	end

	local function savePart(part)
		if part and not ModifiedParts[part] then
			ModifiedParts[part] = {
				Size = part.Size,
				Transparency = part.Transparency,
				Color = part.Color,
				Material = part.Material,
				CanCollide = part.CanCollide
			}
		end
	end

	local function restorePart(part)
		local data = ModifiedParts[part]
		if data and part and part.Parent then
			pcall(function()
				part.Size = data.Size
				part.Transparency = data.Transparency
				part.Color = data.Color
				part.Material = data.Material
				part.CanCollide = data.CanCollide
			end)
			ModifiedParts[part] = nil
		end
	end

	local function restoreAll()
		for part in pairs(ModifiedParts) do
			restorePart(part)
		end
		ModifiedParts = {}
	end

	local function clearESP()
		for char, h in pairs(ActiveHighlights) do
			if h and h.Parent then h:Destroy() end
		end
		ActiveHighlights = {}
	end

	local function showDeathWhisper(pos)
		if not DEATH_WHISPER then return end
		local msg = scaryMessages[math.random(1, #scaryMessages)]
		local part = Instance.new("Part")
		part.Anchored = true
		part.CanCollide = false
		part.Transparency = 1
		part.Position = pos + Vector3.new(0, 3, 0)
		part.Parent = Workspace

		local bill = Instance.new("BillboardGui")
		bill.Size = UDim2.new(0, 200, 0, 40)
		bill.AlwaysOnTop = true
		bill.Adornee = part
		bill.Parent = part

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1,0,1,0)
		label.BackgroundTransparency = 1
		label.Text = msg
		label.TextColor3 = Color3.fromRGB(255, 60, 60)
		label.TextStrokeTransparency = 0.3
		label.Font = Enum.Font.GothamBold
		label.TextSize = 14
		label.Parent = bill

		task.delay(3.5, function()
			part:Destroy()
		end)
	end

	local function onNPCDamaged(char)
		if not AGGRO_SOUND then return end
		if DamagedNPCs[char] then return end
		DamagedNPCs[char] = true
		playAggroSound()
	end

	local function applyNPCHitbox(char)
		if not isNPC(char) then return end
		local dist = getDistance(char)
		if dist > maxDistance then return end

		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return end

		local sizeMult = 1
		if AUTO_SIZE then
			sizeMult = math.clamp(1.35 - (dist / 150), 0.75, 1.35)
		end

		local finalColor = currentColor
		if THREAT_COLOR then
			if dist <= 18 then
				finalColor = Color3.fromRGB(255, 20, 20)
			elseif dist <= 40 then
				finalColor = Color3.fromRGB(255, 140, 30)
			else
				finalColor = Color3.fromRGB(30, 220, 70)
			end
		end

		local head = char:FindFirstChild("Head")
		local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")

		if useHead and head then
			savePart(head)
			head.Size = Vector3.new(headSize * sizeMult, headSize * sizeMult, headSize * sizeMult)
			head.Material = Enum.Material.Neon
			head.Color = finalColor
			head.Transparency = transparency
			head.CanCollide = false

			if PULSE then
				task.spawn(function()
					local original = head.Size
					head.Size = original * 1.3
					task.wait(0.12)
					if head and head.Parent then
						head.Size = original
					end
				end)
			end
		end
		if useBody and hrp then
			savePart(hrp)
			hrp.Size = Vector3.new(bodySize * sizeMult, bodySize * sizeMult, bodySize * sizeMult)
			hrp.Material = Enum.Material.Neon
			hrp.Color = finalColor
			hrp.Transparency = transparency
			hrp.CanCollide = false
		end
		if MELEE_ON then
			for _, part in pairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					savePart(part)
					part.Size = Vector3.new(5 * sizeMult, 5 * sizeMult, 5 * sizeMult)
					part.Transparency = transparency
					part.CanCollide = false
				end
			end
		end
	end

	local function applyESP(char)
		if not isNPC(char) then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return end

		local h = ActiveHighlights[char]
		if not h or not h.Parent then
			h = Instance.new("Highlight")
			h.Name = "NPCHighlight"
			h.Adornee = char
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.Parent = char
			ActiveHighlights[char] = h
		end
		h.FillColor = currentColor
		h.FillTransparency = fillTrans
		h.Enabled = true
	end

	local function onNPCDied(char)
		if REMOVE_ON_DEATH then
			for _, part in pairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					restorePart(part)
				end
			end
		end

		local h = ActiveHighlights[char]
		if h then
			h:Destroy()
			ActiveHighlights[char] = nil
		end

		if DEATH_WHISPER then
			local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
			if root then
				showDeathWhisper(root.Position)
			end
		end

		KnownNPCs[char] = nil
		DamagedNPCs[char] = nil
	end

	local function registerNPC(char)
		if KnownNPCs[char] then return end
		if not isNPC(char) then return end
		KnownNPCs[char] = true

		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Died:Connect(function()
				onNPCDied(char)
			end)

			hum.HealthChanged:Connect(function()
				if hum.Health < hum.MaxHealth then
					onNPCDamaged(char)
				end
			end)
		end
	end

	-- When player takes damage → play sound + highlight nearby NPCs for 8 seconds
	local function setupPlayerDamageDetection()
		local function connectCharacter(char)
			local hum = char:WaitForChild("Humanoid", 5)
			if not hum then return end

			local lastHealth = hum.Health
			hum.HealthChanged:Connect(function(newHealth)
				if newHealth < lastHealth then
					-- Player took damage
					playAggroSound()

					-- Highlight nearby NPCs for 8 seconds
					for npc in pairs(KnownNPCs) do
						if npc and npc.Parent then
							local dist = getDistance(npc)
							if dist <= 60 then
								tempHighlight(npc)
							end
						end
					end
				end
				lastHealth = newHealth
			end)
		end

		if lp.Character then
			connectCharacter(lp.Character)
		end
		lp.CharacterAdded:Connect(connectCharacter)
	end
	setupPlayerDamageDetection()

	-- Initial scan
	for _, obj in pairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") and isNPC(obj) then
			registerNPC(obj)
		end
	end

	Workspace.DescendantAdded:Connect(function(obj)
		if obj:IsA("Humanoid") and obj.Parent then
			task.defer(function()
				registerNPC(obj.Parent)
				if HITBOX_ON then applyNPCHitbox(obj.Parent) end
				if ESP_ON then applyESP(obj.Parent) end
			end)
		end
	end)

	local lastUpdate = 0
	RunService.Heartbeat:Connect(function()
		if not HITBOX_ON and not ESP_ON then return end
		if tick() - lastUpdate < 0.5 then return end
		lastUpdate = tick()

		for char in pairs(KnownNPCs) do
			if char and char.Parent then
				if HITBOX_ON then applyNPCHitbox(char) end
				if ESP_ON then applyESP(char) end
			else
				KnownNPCs[char] = nil
			end
		end
	end)

	local function refresh()
		if HITBOX_ON then
			for char in pairs(KnownNPCs) do
				if char and char.Parent then applyNPCHitbox(char) end
			end
		else
			restoreAll()
		end
		if ESP_ON then
			for char in pairs(KnownNPCs) do
				if char and char.Parent then applyESP(char) end
			end
		else
			clearESP()
		end
	end

