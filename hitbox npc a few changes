	bodyBx.FocusLost:Connect(function() local n=tonumber(bodyBx.Text); if n and n>0 then bodySize=n end end)
	transBx.FocusLost:Connect(function() local n=tonumber(transBx.Text); if n and n>=0 and n<=1 then transparency=n end end)
	distBx.FocusLost:Connect(function() local n=tonumber(distBx.Text); if n then maxDistance=math.clamp(n,50,2000); distBx.Text=tostring(maxDistance) end end)
	pHeadBx.FocusLost:Connect(function() local n=tonumber(pHeadBx.Text); if n and n>0 then pHeadSize=n end end)
	pBodyBx.FocusLost:Connect(function() local n=tonumber(pBodyBx.Text); if n and n>0 then pBodySize=n end end)
	pTransBx.FocusLost:Connect(function() local n=tonumber(pTransBx.Text); if n and n>=0 and n<=1 then pTrans=n end end)

	print("Hitbox + Horror ready")
end

