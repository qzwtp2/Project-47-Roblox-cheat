	-- CORE
	local function isNPC(model)
		if not model or not model:IsA("Model") then return false end
		if not model:FindFirstChildOfClass("Humanoid") then return false end
		return Players:GetPlayerFromCharacter(model)==nil
	end
	local function getDist(char)
		local mr=lp.Character and (lp.Character:FindFirstChild("HumanoidRootPart") or lp.Character:FindFirstChild("Torso"))
		local or2=char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
		if mr and or2 then return (mr.Position-or2.Position).Magnitude end; return 9999
	end
	local function isFriend(plr)
		local ok,res=pcall(function() return lp:IsFriendsWith(plr.UserId) end); return ok and res
	end
	local function getNearestEnemy()
		local nearest,nd=nil,math.huge
		for char in pairs(KnownNPCs) do if char and char.Parent then local d=getDist(char); if d<nd then nearest=char; nd=d end end end
		for plr in pairs(KnownPlayers) do if plr and plr.Character then local d=getDist(plr.Character); if d<nd then nearest=plr.Character; nd=d end end end
		return nearest,nd
	end
	local function getHPColor(hum)
		if not hum then return Color3.fromRGB(60,210,100) end
		local pct=math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
		if pct>0.6 then local t=1-((pct-0.6)/0.4); return Color3.fromRGB(math.floor(255*t),210,math.floor(60*(1-t)))
		else local t=pct/0.6; return Color3.fromRGB(255,math.floor(180*t),0) end
	end
	local function jit(v) return v+(math.random()-0.5)*0.1 end
	local function savePart(p)
		if p and not ModifiedParts[p] then
			ModifiedParts[p]={Size=p.Size,Transparency=p.Transparency,Color=p.Color,Material=p.Material,CanCollide=p.CanCollide}
		end
	end
	local function restorePart(p)
		local d=ModifiedParts[p]
		if d and p and p.Parent then
			pcall(function() p.Size=d.Size; p.Transparency=d.Transparency; p.Color=d.Color; p.Material=d.Material; p.CanCollide=d.CanCollide end)
			ModifiedParts[p]=nil
		end
	end
	local function restoreAll() for p in pairs(ModifiedParts) do restorePart(p) end; ModifiedParts={} end
