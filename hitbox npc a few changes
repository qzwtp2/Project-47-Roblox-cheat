local MUSIC_URL="https://raw.githubusercontent.com/HaTapLamScript/MAMBO-PROJECT/refs/heads/main/Script/UNIVERSAL/Youtube_player.lua"

local function launch(withHitbox,withMusic)
	launcherGui:Destroy(); showSpinner()
	task.spawn(function()
		if withHitbox then setupHitbox() end
		if withMusic then task.wait(withHitbox and 0.5 or 0); loadstring(game:HttpGet(MUSIC_URL))() end
		task.wait(0.3); hideSpinner(); spinnerGui:Destroy()
	end)
end

greenBtn.MouseButton1Click:Connect(function() launch(true,false) end)
blueBtn.MouseButton1Click:Connect(function() launch(true,true) end)
yellowBtn.MouseButton1Click:Connect(function() launch(false,true) end)

