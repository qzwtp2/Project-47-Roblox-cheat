	local function applyHitbox(char,isPlr,uH,uB,hSz,bSz,tr,mel,threat,hpCol)
		local dist=getDist(char); if dist>maxDistance then return end
		local hum=char:FindFirstChildOfClass("Humanoid"); if not hum or hum.Health<=0 then return end
		local fc=currentColor
		if hpCol and isPlr then fc=getHPColor(hum)
		elseif threat then
			if dist<=18 then fc=Color3.fromRGB(255,40,40)
			elseif dist<=40 then fc=Color3.fromRGB(255,160,40)
			else fc=Color3.fromRGB(40,220,100) end
		end
		local rH=RAGE_MODE and 10 or hSz; local rB=RAGE_MODE and 10 or bSz; local rM=RAGE_MODE or mel
		local sm=1
		if AUTO_SIZE then sm=math.clamp(1.3-(dist/160),0.7,1.3) end
		if HITBOX_PULSE then pulseTime=pulseTime+0.05; sm=sm*(1+0.15*math.sin(pulseTime*4)) end
		local head=char:FindFirstChild("Head")
		local hrp=char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
		if uH and head then
			savePart(head)
			pcall(function() head.Size=Vector3.new(jit(rH*sm),jit(rH*sm),jit(rH*sm)); head.Material=Enum.Material.Neon; head.Color=fc; head.Transparency=tr; head.CanCollide=false end)
		end
		if uB and hrp then
			savePart(hrp)
			pcall(function() hrp.Size=Vector3.new(jit(rB*sm),jit(rB*sm),jit(rB*sm)); hrp.Material=Enum.Material.Neon; hrp.Color=fc; hrp.Transparency=tr; hrp.CanCollide=false end)
		end
		if rM then
			for _,p in pairs(char:GetDescendants()) do
				if p:IsA("BasePart") then savePart(p); pcall(function() p.Size=Vector3.new(jit(5*sm),jit(5*sm),jit(5*sm)); p.Transparency=tr; p.CanCollide=false end) end
			end
		end
		if RED_SYMBOL and dist<=18 and head then pcall(function() head.Color=Color3.fromRGB(255,30,30) end) end
		if INDICATOR and dist<=25 then playAggro() end
	end

	local function applyESP(char)
		if not isNPC(char) then return end
		local dist=getDist(char); if dist>maxDistance then return end
		local hum=char:FindFirstChildOfClass("Humanoid"); if not hum or hum.Health<=0 then return end
		local h=ActiveHighlights[char]
		if not h or not h.Parent then
			h=Instance.new("Highlight"); h.Adornee=char; h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; h.Parent=char; ActiveHighlights[char]=h
		end
		h.FillColor=ESP_COLOR
		if ESP_STYLE=="Faint" then h.FillTransparency=0.7; h.OutlineTransparency=0.3
		else h.FillTransparency=0.4; h.OutlineTransparency=0 end; h.Enabled=true
	end

	local function applyPESP(plr)
		if plr==lp or not plr.Character then return end
		local dist=getDist(plr.Character); if dist>maxDistance then return end
		if PESP_TEAM_CHECK and lp.Team and plr.Team and lp.Team==plr.Team then return end
		if PESP_FRIEND_CHECK and isFriend(plr) then return end
		local hum=plr.Character:FindFirstChildOfClass("Humanoid"); if not hum or hum.Health<=0 then return end
		local h=PlayerHighlights[plr]
		if not h or not h.Parent then
			h=Instance.new("Highlight"); h.Adornee=plr.Character; h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; h.Parent=plr.Character; PlayerHighlights[plr]=h
		end
		local hc=getHPColor(hum); h.FillColor=hc; h.OutlineColor=hc
		if ESP_STYLE=="Faint" then h.FillTransparency=0.7; h.OutlineTransparency=0.3
		else h.FillTransparency=0.4; h.OutlineTransparency=0 end; h.Enabled=true
	end

