	local lastTipBtn=nil
	local function showTip(text,btn)
		-- toggle: same button clicked again = hide
		if tooltip.Visible and lastTipBtn==btn then
			tooltip.Visible=false; lastTipBtn=nil; return
		end
		ttText.Text=text
		local ap=btn.AbsolutePosition
		-- keep tooltip on screen
		local xPos=ap.X+btn.AbsoluteSize.X+6
		local yPos=ap.Y
		tooltip.Position=UDim2.new(0,xPos,0,yPos)
		tooltip.Visible=true; lastTipBtn=btn
	end
