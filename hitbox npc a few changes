		while #CorruptionParts[char]<8 do
			local p=Instance.new("Part"); p.Anchored=true; p.CanCollide=false; p.Size=Vector3.new(0.3,0.3,0.3)
			p.Material=Enum.Material.Neon; p.Color=Color3.fromRGB(math.random(20,80),0,math.random(20,80))
			p.Transparency=0.2; p.CastShadow=false; p.Parent=Workspace; table.insert(CorruptionParts[char],p)
		end
		local t=tick()
		for i,p in pairs(CorruptionParts[char]) do
			if p and p.Parent then
				local ang=(t*2.5)+(i*(math.pi*2/8))
				p.Position=hrp.Position+Vector3.new(math.cos(ang)*1.2,math.sin(t*3+i)*0.8,math.sin(ang)*1.2)
