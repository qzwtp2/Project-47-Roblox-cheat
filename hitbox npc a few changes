		clean(ShadowClones); clean(FloatNumBillboards); clean(MarkBillboards); clean(GroundCrackParts)
	end

	local function registerNPC(char)
		if KnownNPCs[char] then return end
		if not isNPC(char) then return end; KnownNPCs[char]=true
		local hum=char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Died:Connect(function()
				local hrp=char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
				local pos=hrp and hrp.Position or Vector3.new(0,0,0)
				if REMOVE_ON_DEATH then for _,p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then restorePart(p) end end end
				if DEATH_WHISPER then playAggro() end
				local h=ActiveHighlights[char]; if h then h:Destroy(); ActiveHighlights[char]=nil end
				onKill(char,pos); KnownNPCs[char]=nil
			end)
		end
	end
