-- Aggro Sound
local angrySound = Instance.new("Sound")
angrySound.SoundId = "rbxassetid://0" -- ← REPLACE 0 WITH YOUR SOUND ID
angrySound.Volume = 1.2
angrySound.Parent = SoundService

local function playAggroSound()
	if not AGGRO_SOUND then return end
	if angrySound.SoundId == "rbxassetid://0" then return end
	if tick() - lastSoundTime < SOUND_COOLDOWN then return end
	lastSoundTime = tick()
	angrySound:Play()
end

-- Temporary 8 second highlight
local function tempHighlight(char)
	if not char or not char.Parent then return end
	if TempHighlights[char] then return end

	local h = Instance.new("Highlight")
	h.Name = "TempAggroHighlight"
	h.Adornee = char
	h.FillColor = Color3.fromRGB(255, 50, 50)
	h.FillTransparency = 0.3
	h.OutlineColor = Color3.fromRGB(255, 0, 0)
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = char

	TempHighlights[char] = h

	task.delay(8, function()
		if h and h.Parent then
			h:Destroy()
		end
		TempHighlights[char] = nil
	end)
end

