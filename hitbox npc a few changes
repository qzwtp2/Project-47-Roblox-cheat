	local function isNPC(model)
		if not model or not model:IsA("Model") then return false end
		local hum = model:FindFirstChildOfClass("Humanoid")
		if not hum then return false end
		return Players:GetPlayerFromCharacter(model) == nil
	end

	local function markAggressive(model)
		if model and model.Parent then
			AggressiveTargets[model] = true
		end
	end

	local function applyNPCHitbox(char)
		if UNSURE and not AggressiveTargets[char] then
			return
		end

		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return end

		local head = char:FindFirstChild("Head")
		local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")

		if useHead and head then
			head.Size = Vector3.new(headSize, headSize, headSize)
			head.Material = Enum.Material.Neon
			head.Color = Color3.fromRGB(255,40,40)
			head.CanCollide = false
		end
		if useBody and hrp then
			hrp.Size = Vector3.new(bodySize, bodySize, bodySize)
			hrp.Material = Enum.Material.Neon
			hrp.Color = Color3.fromRGB(255,40,40)
			hrp.CanCollide = false
		end
		if MELEE_ON then
			for _, part in pairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.Size = Vector3.new(5,5,5)
					part.CanCollide = false
				end
			end
		end
	end

	local function applyESP(char)
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return end
		local h = char:FindFirstChild("NPCHighlight")
		if not h then
			h = Instance.new("Highlight")
			h.Name = "NPCHighlight"
			h.Adornee = char
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.Parent = char
		end
		h.FillColor = currentColor
		h.FillTransparency = fillTrans
		h.Enabled = true
	end

	local function applyToAll()
		for _, obj in pairs(Workspace:GetDescendants()) do
			if obj:IsA("Model") and isNPC(obj) then
				if HITBOX_ON then
					applyNPCHitbox(obj)
				end
				if ESP_ON then
					applyESP(obj)
				end
			end
		end
	end

	-- Detect when you take damage
	local function onLocalHealthChanged()
		local char = lp.Character
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum then return end

		local lastHealth = hum.Health
		hum.HealthChanged:Connect(function(newHealth)
			if newHealth < lastHealth then
				local root = char:FindFirstChild("HumanoidRootPart")
				if root then
					for _, obj in pairs(Workspace:GetDescendants()) do
						if obj:IsA("Model") and isNPC(obj) then
							local otherRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
							if otherRoot and (otherRoot.Position - root.Position).Magnitude < 25 then
								markAggressive(obj)
								if HITBOX_ON then
									applyNPCHitbox(obj)
								end
							end
						end
					end
				end
			end
			lastHealth = newHealth
		end)
	end

	-- Detect when you attack
	local function setupAttackDetection()
		local char = lp.Character
		if not char then return end
		local function onTool(tool)
			if tool:IsA("Tool") then
				tool.Activated:Connect(function()
					local root = char:FindFirstChild("HumanoidRootPart")
					if not root then return end
					for _, obj in pairs(Workspace:GetDescendants()) do
						if obj:IsA("Model") and isNPC(obj) then
							local otherRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
							if otherRoot and (otherRoot.Position - root.Position).Magnitude < 20 then
								markAggressive(obj)
								if HITBOX_ON then
									applyNPCHitbox(obj)
								end
							end
						end
					end
				end)
			end
		end
		char.ChildAdded:Connect(onTool)
		for _, child in pairs(char:GetChildren()) do
			onTool(child)
		end
	end

	local function onCharacter(char)
		task.wait(0.5)
		onLocalHealthChanged()
		setupAttackDetection()
	end

