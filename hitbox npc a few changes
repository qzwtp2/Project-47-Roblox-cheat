local function isNPC(model)
	if not model or not model:IsA("Model") then return false end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then return false end
	return Players:GetPlayerFromCharacter(model) == nil
end

local function getDistance(char)
	local myRoot = lp.Character and (lp.Character:FindFirstChild("HumanoidRootPart") or lp.Character:FindFirstChild("Torso"))
	local otherRoot = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
	if myRoot and otherRoot then return (myRoot.Position - otherRoot.Position).Magnitude end
	return 9999
end

local function isFriend(plr)
	local ok, res = pcall(function() return lp:IsFriendsWith(plr.UserId) end)
	return ok and res
end

local function savePart(part)
	if part and not ModifiedParts[part] then
		ModifiedParts[part] = {Size=part.Size,Transparency=part.Transparency,Color=part.Color,Material=part.Material,CanCollide=part.CanCollide}
	end
end

local function restorePart(part)
	local data = ModifiedParts[part]
	if data and part and part.Parent then
		pcall(function()
			part.Size=data.Size part.Transparency=data.Transparency part.Color=data.Color part.Material=data.Material part.CanCollide=data.CanCollide
		end)
		ModifiedParts[part] = nil
	end
end

local function restoreAll()
	for part in pairs(ModifiedParts) do restorePart(part) end
	ModifiedParts = {}
end

local function clearESP()
	for char,h in pairs(ActiveHighlights) do if h and h.Parent then h:Destroy() end end
	ActiveHighlights = {}
end

local function applyHitbox(char, isPlayer, useHead, useBody, hSize, bSize, trans, meleeOn, threatOn)
	local dist = getDistance(char)
	if dist > maxDistance then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end
	local finalColor = currentColor
	if threatOn then
		if dist <= 18 then finalColor = Color3.fromRGB(255,40,40)
		elseif dist <= 40 then finalColor = Color3.fromRGB(255,160,40)
		else finalColor = Color3.fromRGB(40,220,100) end
	end
	local sizeMult = 1
	if AUTO_SIZE then sizeMult = math.clamp(1.3-(dist/160),0.7,1.3) end
	if HITBOX_PULSE then pulseTime=pulseTime+0.05 sizeMult=sizeMult*(1+0.15*math.sin(pulseTime*4)) end
	local head = char:FindFirstChild("Head")
	local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
	if useHead and head then
		savePart(head)
		head.Size=Vector3.new(hSize*sizeMult,hSize*sizeMult,hSize*sizeMult)
		head.Material=Enum.Material.Neon head.Color=finalColor head.Transparency=trans head.CanCollide=false
	end
	if useBody and hrp then
		savePart(hrp)
		hrp.Size=Vector3.new(bSize*sizeMult,bSize*sizeMult,bSize*sizeMult)
		hrp.Material=Enum.Material.Neon hrp.Color=finalColor hrp.Transparency=trans hrp.CanCollide=false
	end
	if meleeOn then
		for _,part in pairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				savePart(part) part.Size=Vector3.new(5*sizeMult,5*sizeMult,5*sizeMult) part.Transparency=trans part.CanCollide=false
			end
		end
	end
	if RED_SYMBOL and dist<=18 and head then head.Color=Color3.fromRGB(255,30,30) end
	if INDICATOR and dist<=25 then playAggroSound() end
end

local function applyESP(char)
	if not isNPC(char) then return end
	local dist = getDistance(char)
	if dist > maxDistance then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health<=0 then return end
	local h = ActiveHighlights[char]
	if not h or not h.Parent then
		h = Instance.new("Highlight")
		h.Adornee=char h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop h.Parent=char
		ActiveHighlights[char]=h
	end
	h.FillColor=ESP_COLOR
	if ESP_STYLE=="Faint" then h.FillTransparency=0.7 h.OutlineTransparency=0.3
	else h.FillTransparency=0.4 h.OutlineTransparency=0 end
	h.Enabled=true
end

local function registerNPC(char)
	if KnownNPCs[char] then return end
	if not isNPC(char) then return end
	KnownNPCs[char]=true
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.Died:Connect(function()
			if REMOVE_ON_DEATH then
				for _,part in pairs(char:GetDescendants()) do if part:IsA("BasePart") then restorePart(part) end end
			end
			if DEATH_WHISPER then playAggroSound() end
			local h=ActiveHighlights[char] if h then h:Destroy() ActiveHighlights[char]=nil end
			KnownNPCs[char]=nil
		end)
	end
end

