		local cp2=clone:GetDescendants(); local chars={}
		for _,p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then table.insert(chars,p) end end
		for i,cp in pairs(cp2) do if cp:IsA("BasePart") and chars[i] then pcall(function() cp.CFrame=chars[i].CFrame*CFrame.new(0,-0.3,0) end) end end
