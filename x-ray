local function UpdateTagColors(plr)
    local data = PerPlayer[plr]
    if not data then return end
    local bill = data.Billboard
    if not bill then return end
    local nameColor = State.NightMode and Color3.fromRGB(255, 60, 60) or THEME.Neon
    local dimColor  = State.NightMode and Color3.fromRGB(255, 120, 120) or THEME.TextDim
    local softColor = State.NightMode and Color3.fromRGB(255, 80, 80) or THEME.NeonSoft
    for _, child in ipairs(bill:GetChildren()) do
        if child:IsA("TextLabel") then
            if child.Text:find("%[") then child.TextColor3 = nameColor
            elseif child.Text:find("dist") then child.TextColor3 = softColor
            elseif child.Text:find("hand:") then child.TextColor3 = dimColor
            elseif child.Text:find("/") then child.TextColor3 = dimColor
            end
        end
    end
    if data.BarFill then
        data.BarFill.BackgroundColor3 = State.NightMode and Color3.fromRGB(255, 60, 60) or THEME.Neon
    end
end

local function SetupPlayer(plr)
    if plr == localPlr then return end
    if PerPlayer[plr] then
        pcall(function() PerPlayer[plr].Highlight:Destroy() end)
        pcall(function() PerPlayer[plr].Billboard:Destroy() end)
        PerPlayer[plr] = nil
    end
    local char = plr.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not head then return end
    local highlight = New("Highlight", {
        Name = "MatrixHL_" .. plr.Name,
        Adornee = char,
        Parent = char,
        Enabled = false,
        FillTransparency = 1,
        OutlineTransparency = 0,
        OutlineColor = THEME.Neon,
        FillColor = THEME.Neon,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
    })
    local bill, barFill, distLbl, toolLbl, hpLbl = BuildTagBillboard(plr, head)
    bill.Enabled = false
    PerPlayer[plr] = {
        Highlight = highlight, Billboard = bill, BarFill = barFill,
        DistLbl = distLbl, ToolLbl = toolLbl, HpLbl = hpLbl,
        Humanoid = humanoid, Char = char,
    }
    if State.NightMode then UpdateTagColors(plr) end
end

local function ForEachPlayerEntry(fn)
    for plr, data in pairs(PerPlayer) do
        if plr and plr.Parent then
            local ok = pcall(fn, plr, data)
            if not ok then PerPlayer[plr] = nil end
        end
    end
end

local function bindPlayer(plr)
    if plr == localPlr then return end
    plr.CharacterAdded:Connect(function()
        task.wait(0.4)
        SetupPlayer(plr)
    end)
    if plr.Character then task.spawn(SetupPlayer, plr) end
end

for _, p in ipairs(Players:GetPlayers()) do bindPlayer(p) end
Players.PlayerAdded:Connect(function(p) bindPlayer(p) end)
