local Glasses = {
    Container = nil, Root = nil, Weld = nil, Parts = {},
    EyeCF = nil, ForeCF = nil, Busy = false,
}

local function DestroyGlasses()
    if Glasses.Container then pcall(function() Glasses.Container:Destroy() end) end
    Glasses.Container, Glasses.Root, Glasses.Weld = nil, nil, nil
    Glasses.Parts = {}
    Glasses.Busy = false
end

local function ProceduralVisor(head)
    local W, H, D = head.Size.X, head.Size.Y, head.Size.Z
    local model = Instance.new("Model")
    model.Name = "MatrixVisor"
    local lens = New("Part", {
        Name = "Lens",
        Size = Vector3.new(W * 0.96, H * 0.30, 0.12),
        Color = THEME.Neon,
        Material = Enum.Material.Neon,
        Transparency = 0.12,
        CanCollide = false, Anchored = false, Massless = true,
        Parent = model,
    })
    local brow = New("Part", {
        Name = "Brow",
        Size = Vector3.new(W * 1.04, H * 0.07, 0.10),
        Color = Color3.fromRGB(4, 14, 9),
        Material = Enum.Material.SmoothPlastic,
        CanCollide = false, Massless = true,
        Parent = model,
    })
    New("Weld", { Part0 = lens, Part1 = brow, C0 = CFrame.new(0, H * 0.17, 0), Parent = brow })
    for _, side in ipairs({ -1, 1 }) do
        local arm = New("Part", {
            Size = Vector3.new(0.07, 0.07, D * 0.85),
            Color = Color3.fromRGB(4, 14, 9),
            Material = Enum.Material.SmoothPlastic,
            CanCollide = false, Massless = true,
            Parent = model,
        })
        New("Weld", {
            Part0 = lens, Part1 = arm,
            C0 = CFrame.new(side * (W * 0.52), H * 0.08, D * 0.40),
            Parent = arm,
        })
    end
    model.PrimaryPart = lens
    return model
end

local function TryAsset(char)
    local ok, objs = pcall(function() return game:GetObjects(ASSET_GLASSES) end)
    if not (ok and objs and objs[1]) then return nil, nil end
    local item = objs[1]
    local handle
    if item:IsA("BasePart") then
        handle = item
    else
        handle = item:FindFirstChild("Handle")
        if not handle then
            local ok2, res = pcall(function() return item:FindFirstChildWhichIsA("BasePart", true) end)
            if ok2 then handle = res end
        end
    end
    if not handle then pcall(function() item:Destroy() end) return nil, nil end
    for _, d in ipairs(item:GetDescendants()) do
        if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("AccessoryWeld") then
            pcall(function() d:Destroy() end)
        end
    end
    pcall(function()
        handle.Anchored = false
        handle.CanCollide = false
        handle.Massless = true
        handle.Color = THEME.Neon
        handle.Material = Enum.Material.Neon
        handle.Transparency = 0.08
    end)
    item.Parent = char
    return item, handle
end

local function EquipGlasses()
    DestroyGlasses()
    local char = localPlr.Character
    local head = char and char:FindFirstChild("Head")
    if not head then return end
    local container, root
    local parts = {}
    local item, handle = TryAsset(char)
    if handle then
        container, root = item, handle
        parts = { handle }
    else
        local model = ProceduralVisor(head)
        container, root = model, model.PrimaryPart
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") then table.insert(parts, d) end
        end
        model.Parent = char
    end
    if not root then return end
    local eyeCF  = CFrame.new(0, head.Size.Y * 0.12, -(head.Size.Z * 0.25 + 0.03))
    local foreCF = CFrame.new(0, head.Size.Y * 0.66, -(head.Size.Z * 0.02))
    root.Anchored = false
    local weld = Instance.new("Weld")
    weld.Name   = "MatrixVisorWeld"
    weld.Part0  = head
    weld.Part1  = root
    weld.C0     = State.Master and eyeCF or foreCF
    weld.Parent = root
    Glasses.Container = container
    Glasses.Root      = root
    Glasses.Weld      = weld
    Glasses.Parts     = parts
    Glasses.EyeCF     = eyeCF
    Glasses.ForeCF    = foreCF
    task.spawn(function()
        for i = 1, 8 do
            local a = i / 8
            for _, p in ipairs(Glasses.Parts) do
                pcall(function() p.Transparency = math.clamp(1 - a * 0.88, 0.1, 1) end)
            end
            task.wait(0.035)
        end
    end)
end

local function SlideGlasses(toEyes)
    local weld, eye, fore = Glasses.Weld, Glasses.EyeCF, Glasses.ForeCF
    if not weld or Glasses.Busy then return end
    Glasses.Busy = true
    if toEyes then
        pcall(function() ActSound.TimePosition = 0; ActSound:Play() end)
        local t1 = TweenSvc:Create(weld,
            TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            { C0 = eye * CFrame.new(0, -0.10, -0.02) })
        t1:Play(); t1.Completed:Wait()
        if Glasses.Weld ~= weld then Glasses.Busy = false return end
        local t2 = TweenSvc:Create(weld,
            TweenInfo.new(0.30, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out),
            { C0 = eye })
        t2:Play(); t2.Completed:Wait()
    else
        local t1 = TweenSvc:Create(weld,
            TweenInfo.new(0.38, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            { C0 = fore * CFrame.new(0, 0.06, 0) })
        t1:Play(); t1.Completed:Wait()
        if Glasses.Weld ~= weld then Glasses.Busy = false return end
        local t2 = TweenSvc:Create(weld,
            TweenInfo.new(0.16, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
            { C0 = fore })
        t2:Play(); t2.Completed:Wait()
    end
    Glasses.Busy = false
end

localPlr.CharacterAdded:Connect(function()
