local XRayCache = {}
local WallCache = {}

local function ApplyXRayPart(part, cache, amount)
    if part:IsA("BasePart") and not part:IsA("Terrain") and not isCharPart(part) then
        if cache[part] == nil then cache[part] = part.LocalTransparencyModifier end
        part.LocalTransparencyModifier = amount
    end
end

local function ClearCache(cache)
    for part, oldVal in pairs(cache) do
        if part and part.Parent then
            pcall(function() part.LocalTransparencyModifier = oldVal or 0 end)
        end
        cache[part] = nil
    end
end

function RefreshWorldTransparency()
    if not State.XRay then ClearCache(XRayCache) end
    if not State.Wall  then ClearCache(WallCache)  end
    if not State.XRay and not State.Wall then return end

    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst:IsA("BasePart") and not inst:IsA("Terrain") and not isCharPart(inst) then
            if State.XRay then ApplyXRayPart(inst, XRayCache, 0.60) end
            if State.Wall and inst.Transparency == 0 then ApplyXRayPart(inst, WallCache, 0.35) end
        end
    end
end

Workspace.DescendantAdded:Connect(function(inst)
    if inst:IsA("BasePart") and not isCharPart(inst) then
        if State.XRay then ApplyXRayPart(inst, XRayCache, 0.60) end
        if State.Wall and inst.Transparency == 0 then ApplyXRayPart(inst, WallCache, 0.35) end
    end
end)

