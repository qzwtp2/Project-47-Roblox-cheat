local pulse = 0
RunService.Heartbeat:Connect(function(dt)
    pulse += dt
    StrokeGrad.Rotation = (StrokeGrad.Rotation + dt * 60) % 360

    if not (State.ESP or State.Chams or State.TagESP) then return end

    local myRoot = localPlr.Character and localPlr.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    ForEachPlayerEntry(function(plr, d)
        local char = d.Char
        if not char or not char.Parent then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local dist      = (root.Position - myRoot.Position).Magnitude
        -- Fixed: uses the exact ESP_MAX_DISTANCE from the input
        local withinESP = dist <= ESP_MAX_DISTANCE

        if State.ESP or State.Chams then
            d.Highlight.Enabled = withinESP and (State.ESP or State.Chams)
        end

        if State.Chams and withinESP then
            local s = 0.5 + 0.5 * math.sin(pulse * 3)
            if State.NightMode then
                d.Highlight.FillColor    = Color3.fromRGB(255, 60 + 55 * s, 60)
                d.Highlight.OutlineColor = Color3.fromRGB(255, 80, 80)
            else
                d.Highlight.FillColor    = Color3.fromRGB(0, 200 + 55 * s, 110 + 60 * s)
                d.Highlight.OutlineColor = THEME.NeonSoft
            end
        end

        if State.TagESP and withinESP then
            d.DistLbl.Text = "dist: " .. round(dist) .. " studs"
            local tool = char:FindFirstChildOfClass("Tool")
            d.ToolLbl.Text = "hand: " .. (tool and tool.Name or "empty")
            local hum = d.Humanoid
            if hum and hum.MaxHealth > 0 then
                local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                d.BarFill.Size = UDim2.new(pct, 0, 1, 0)
                if State.NightMode then
                    d.BarFill.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
                else
                    d.BarFill.BackgroundColor3 = Color3.fromRGB(
                        round(255 * (1 - pct)), round(255 * pct), 110)
                end
                d.HpLbl.Text = round(hum.Health) .. "/" .. round(hum.MaxHealth)
            end
        end
    end)
end)

